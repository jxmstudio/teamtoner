# Copy to .env.local for local dev, and set these in Vercel for production.

# Lead forms POST to the JXM Forms backend (see lib/leads.ts). The key is
# publishable by design and already defaulted in code, so this is optional —
# set it only to rotate the key without a code change.
JXM_FORMS_API_KEY=

# FALLBACK email delivery (resend.com), used only if JXM Forms is unreachable.
# If unset, fallback leads are logged to the server console instead of emailed
# (forms still "succeed" so they're testable).
RESEND_API_KEY=
# A verified sender address, e.g. "Team Toner <hello@teamtoner.co.nz>"
LEAD_FROM_EMAIL=

# Public site URL (used for metadata / canonical / OG). Defaults to production.
NEXT_PUBLIC_SITE_URL=https://teamtoner.co.nz

# ---- Sanity CMS (listings + videos, edited at /studio) ----
# Project "Team Toner" in the jxm org (owner web@jxmstudio.com).
# While unset, the site serves the typed fixtures in lib/content/* instead.
NEXT_PUBLIC_SANITY_PROJECT_ID=l0i206kw
NEXT_PUBLIC_SANITY_DATASET=production

# Pre-launch password gate (proxy.ts + /password). Defaults to "toner123".
SITE_PASSWORD=toner123
# Set to "false" at launch to open the site to the public.
SITE_PASSWORD_ENABLED=true
