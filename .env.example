# Copy to .env.local for local dev, and set these in Vercel for production.

# Lead-form email delivery (resend.com). If unset, leads are logged to the
# server console instead of emailed (forms still "succeed" so they're testable).
RESEND_API_KEY=
# A verified sender address, e.g. "Team Toner <hello@teamtoner.co.nz>"
LEAD_FROM_EMAIL=

# Public site URL (used for metadata / canonical / OG). Defaults to production.
NEXT_PUBLIC_SITE_URL=https://teamtoner.co.nz
